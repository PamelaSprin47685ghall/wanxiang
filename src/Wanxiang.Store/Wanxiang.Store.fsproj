    <Compile Include="DataPaths.fs" />
    <Compile Include="DataLock.fs" />
    <Compile Include="FaultInjector.fs" />
    <Compile Include="Store.fs" />
    <Compile Include="RecoveryBundle.fs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Wanxiang.Core\Wanxiang.Core.fsproj" />
    <ProjectReference Include="..\..\vendor\wanxiang2\libs\DirLock\DirLock.fsproj" />
    <ProjectReference Include="..\..\vendor\wanxiang2\libs\JsonSeq\JsonSeq.fsproj" />
    <ProjectReference Include="..\..\vendor\wanxiang2\libs\Ledger\Ledger.fsproj" />
    <ProjectReference Include="..\..\vendor\wanxiang2\libs\Snapshot\Snapshot.fsproj" />
  </ItemGroup>

</Project>
