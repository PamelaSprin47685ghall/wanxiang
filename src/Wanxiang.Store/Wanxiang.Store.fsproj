<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <!-- 领域胶水：组合归 Wanxiang2.LedgerStore，这里只有编解码、折叠、错误映射与路径选择。 -->
  <ItemGroup>
    <Compile Include="DataPaths.fs" />
    <Compile Include="Store.fs" />
    <Compile Include="RecoveryBundle.fs" />
  </ItemGroup>

  <!-- wanxiang2 只经交付包使用（tools/wanxiang2-feed.sh 产出本地源）。 -->
  <ItemGroup>
    <PackageReference Include="Wanxiang2.LedgerStore" Version="0.0.0-local" />
  </ItemGroup>

  <Target Name="RequireWanxiang2Feed" BeforeTargets="_LoadRestoreGraphEntryPoints;CollectPackageReferences"
          Condition="!Exists('$(MSBuildThisFileDirectory)../../vendor/wanxiang2/artifacts/feed/Wanxiang2.LedgerStore.0.0.0-local.nupkg')">
    <Error Text="wanxiang2 本地包源不存在：先运行 tools/wanxiang2-feed.sh" />
  </Target>

  <ItemGroup>
    <PackageReference Include="Wanxiang2.ChatDomain" Version="0.0.0-local" />
    <PackageReference Include="Wanxiang2.PlainText" Version="0.0.0-local" />
    <PackageReference Include="Wanxiang2.ToolSummary" Version="0.0.0-local" />
  </ItemGroup>

</Project>
