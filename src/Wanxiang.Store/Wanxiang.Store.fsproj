<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <!-- 组装层：机制来自 vendor/wanxiang2 的独立库，这里只做类型映射与路径约定。 -->
