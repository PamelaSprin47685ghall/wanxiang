<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="MessageMap.fs" />
    <Compile Include="HistoryProvider.fs" />
    <Compile Include="AgentRuntime.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Agents.AI" Version="1.20.0" />
    <!-- AG-UI 消息模型：MAF ChatMessage ⇄ AGUIMessage（决策 19/20 现行：AG-UI 为落盘权威） -->
    <PackageReference Include="AGUI.Abstractions" Version="1.0.0" />
    <PackageReference Include="Microsoft.Agents.AI.OpenAI" Version="1.20.0" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Wanxiang2.MessageSerde" Version="0.0.0-local" />
    <PackageReference Include="Wanxiang2.MediaContent" Version="0.0.0-local" />
    <PackageReference Include="Wanxiang2.AgentContent" Version="0.0.0-local" />
    <PackageReference Include="Wanxiang2.ProviderTransports" Version="0.0.0-local" />
    <PackageReference Include="Wanxiang2.ChatDomain" Version="0.0.0-local" />
    <PackageReference Include="Wanxiang2.PlainText" Version="0.0.0-local" />
    <PackageReference Include="Wanxiang2.ToolSummary" Version="0.0.0-local" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Wanxiang2.ConfigStore" Version="0.0.0-local" />
  </ItemGroup>
</Project>
