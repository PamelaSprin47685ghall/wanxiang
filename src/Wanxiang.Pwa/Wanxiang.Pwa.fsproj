<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-browser</TargetFramework>
    <RuntimeIdentifier>browser-wasm</RuntimeIdentifier>
    <WasmMainJSPath>wwwroot/main.js</WasmMainJSPath>
    <WasmRuntimeAssetsLocation>./_framework</WasmRuntimeAssetsLocation>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Program.fs" />
  </ItemGroup>

  <ItemGroup>
    <WasmExtraFilesToDeploy Include="wwwroot/**" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="runtimeconfig.template.json" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Browser" Version="12.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Wanxiang.UI\Wanxiang.UI.fsproj" />
  </ItemGroup>

  <!-- AMD/ANGLE Chrome：Avalonia 默认 failIfMajorPerformanceCaveat=true 会得到“能创建但不呈现 Skia 帧”的 WebGL 上下文，表现为启动画面后白屏。
       构建后补丁 avalonia.js（禁止软渲染回退；见 tools/patch_avalonia_js.py）。 -->
  <Target Name="PatchAvaloniaJsWebGl" AfterTargets="WasmBuildApp">
    <Exec Command="python3 &quot;$(MSBuildThisFileDirectory)../../tools/patch_avalonia_js.py&quot; &quot;$(OutputPath)AppBundle/_framework/avalonia.js&quot;"
          Condition="Exists('$(OutputPath)AppBundle/_framework/avalonia.js')" />
  </Target>

  <!-- PWA 发布产物（AppBundle：index.html + _framework 运行时）同步到桌面 App 输出目录的 pwa/（ServerApp 托管目录），使 pwa 开关开箱即用。
       必须在 PatchAvaloniaJsWebGl / WasmTriggerPublishApp 之后执行，避免拷到未补丁或上一轮旧包。 -->
  <Target Name="CopyPwaToApp" AfterTargets="PatchAvaloniaJsWebGl;WasmTriggerPublishApp">
    <ItemGroup>
      <_PwaFiles Include="$(OutputPath)AppBundle/**/*" />
    </ItemGroup>
    <!-- AppBundle 可能尚不存在（首次构建顺序）：无文件时 Copy 为空操作 -->
    <Copy Condition="'@(_PwaFiles)' != ''" SourceFiles="@(_PwaFiles)"
          DestinationFiles="@(_PwaFiles->'$(MSBuildThisFileDirectory)../Wanxiang.App/bin/$(Configuration)/net10.0/pwa/%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

</Project>
