    <Compile Include="SupportBundle.fs" />
    <Compile Include="ProviderCatalog.fs" />
    <Compile Include="ConfigMutation.fs" />
    <Compile Include="GenerationContext.fs" />
    <Compile Include="BuiltinTools.fs" />
    <Compile Include="ToolRegistry.fs" />
    <Compile Include="TitleGenerator.fs" />
    <Compile Include="ChatOrchestrator.fs" />
    <Compile Include="HostStatus.fs" />
    <Compile Include="WsConnection.fs" />
    <Compile Include="ServerApp.fs" />
  </ItemGroup>

  <ItemGroup>
