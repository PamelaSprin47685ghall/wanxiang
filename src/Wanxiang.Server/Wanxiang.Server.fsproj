    <PackageReference Include="Wanxiang2.ToolSummary" Version="0.0.0-local" />
    <ProjectReference Include="..\Wanxiang.Store\Wanxiang.Store.fsproj" />
    <ProjectReference Include="..\Wanxiang.Agent\Wanxiang.Agent.fsproj" />
