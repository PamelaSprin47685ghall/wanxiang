<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Wanxiang.UI</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Theme.fs" />
    <Compile Include="Icons.fs" />
    <Compile Include="CredentialStore.fs" />
    <Compile Include="MainWindow.fs" />
    <Compile Include="App.fs" />
  </ItemGroup>

  <!-- 内嵌 Sarasa Term SC（OFL-1.1，见 LICENSE-Sarasa.txt）：browser-wasm 的 Skia 无法访问宿主系统字体，
       PWA 中文显示依赖内嵌字体；桌面端同样生效，保证两端字形一致。 -->
  <ItemGroup>
    <AvaloniaResource Include="Assets/Fonts/**" />
    <AvaloniaResource Include="Assets/logo.png" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.0.0" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.0.0" />
    <PackageReference Include="Markdig" Version="1.3.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Wanxiang.Interop\Wanxiang.Interop.csproj" />
    <ProjectReference Include="..\Wanxiang.Core\Wanxiang.Core.fsproj" />
    <ProjectReference Include="..\Wanxiang.Protocol\Wanxiang.Protocol.fsproj" />
    <ProjectReference Include="..\Wanxiang.Client\Wanxiang.Client.fsproj" />
  </ItemGroup>

</Project>
