<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Wanxiang.UI</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- MotionPolicy 必须先于 Tokens 编译：Tokens 的主题颜色补间消费
         MotionLedger.themeColorTransition 与 MotionPolicy.isReduced，
         F# 要求被引用的模块在编译顺序上在前。MotionPolicy 自身无项目内依赖，置顶安全。 -->
    <Compile Include="Design/MotionPolicy.fs" />
    <Compile Include="Design/Spacing.fs" />
    <Compile Include="Design/Palette.fs" />
    <Compile Include="Design/Tokens.fs" />
    <Compile Include="Design/LayoutPolicy.fs" />
    <Compile Include="Design/Metrics.fs" />
    <Compile Include="Design/Icons.fs" />
    <Compile Include="Model/StartupTrace.fs" />
    <Compile Include="Model/ParityProbe.fs" />
    <Compile Include="Model/UiPrefs.fs" />
    <Compile Include="Rich/RichBackend.fs" />
    <Compile Include="Rich/Highlight.fs" />
    <Compile Include="Rich/MathLayout.fs" />
    <Compile Include="Rich/MathVisual.fs" />
    <Compile Include="Model/Markdown.fs" />
    <Compile Include="Model/MessageModel.fs" />
    <Compile Include="Model/ImageShrink.fs" />
    <Compile Include="Model/ConversationExport.fs" />
    <Compile Include="Model/ConversationSummary.fs" />
    <Compile Include="Model/ConversationTransfer.fs" />
    <Compile Include="Model/PendingDeletion.fs" />
    <Compile Include="Model/DesktopLinks.fs" />
    <Compile Include="Model/ErrorRecovery.fs" />
    <Compile Include="Model/Catalog.fs" />
    <Compile Include="Model/HostHealth.fs" />
    <Compile Include="Model/CommandPalette.fs" />
    <Compile Include="Model/UiControllers.fs" />
    <Compile Include="Model/DraftStore.fs" />
    <Compile Include="Model/ProviderPresets.fs" />
    <!-- Interaction 必须先于 Primitives：Primitives 的基控件挂 Interaction.surface。 -->
    <Compile Include="Controls/ImeGuard.fs" />
    <Compile Include="Controls/Interaction.fs" />
    <Compile Include="Controls/Primitives.fs" />
    <Compile Include="Controls/OverlayHost.fs" />
    <Compile Include="Controls/Menu.fs" />
    <Compile Include="Controls/MarkdownRenderer.fs" />
    <Compile Include="CredentialStore.fs" />
    <Compile Include="Views/Brand.fs" />
    <Compile Include="Views/ExportDialog.fs" />
    <Compile Include="Views/ImportDialog.fs" />
    <Compile Include="Views/MessageCard.fs" />
    <Compile Include="Views/ToolApprovalCard.fs" />
    <Compile Include="Views/ChatView.fs" />
    <Compile Include="Views/Composer.fs" />
    <Compile Include="Views/ModelSwitcherView.fs" />
    <Compile Include="Views/CommandPaletteView.fs" />
    <Compile Include="Views/OnboardingCard.fs" />
    <Compile Include="Views/Sidebar.fs" />
    <Compile Include="Views/SettingsProviders.fs" />
    <Compile Include="Views/SettingsTools.fs" />
    <Compile Include="Views/SettingsGeneral.fs" />
    <Compile Include="Views/SettingsDevices.fs" />
    <Compile Include="Views/SettingsView.fs" />
    <Compile Include="Views/Dialogs.fs" />
    <Compile Include="Views/MainLayout.fs" />
    <Compile Include="AppShell.fs" />
    <Compile Include="Views/MainWindow.fs" />
    <Compile Include="App.fs" />
  </ItemGroup>

  <!-- 内嵌 Sarasa Term SC（OFL-1.1，见 LICENSE-Sarasa.txt）：browser-wasm 的 Skia 无法访问宿主系统字体，
       PWA 中文显示依赖内嵌字体；桌面端同样生效，保证两端字形一致。 -->
  <ItemGroup>
    <AvaloniaResource Include="Assets/Fonts/**" />
    <AvaloniaResource Include="Assets/logo.png" />
  </ItemGroup>

  <!-- highlight.js（BSD-3-Clause）与 KaTeX（MIT）由 tools/build_webassets.js 装配。
       脚本走**清单资源**而不是 AvaloniaResource：avares 只有在 Avalonia 初始化之后
       才可读，而脚本要在后台预热线程里、以及单元测试里读，那时框架还没起来。
       KaTeX 字体反过来是真正的视觉资源，与正文字体同放 Assets/Fonts，
       由上面那条 AvaloniaResource 一并打包。 -->
  <ItemGroup>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.2" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.2" />
    <!-- 图标：Lucide 官方控件集（ISC）。字形几何全部由上游负责，
         万象只做语义映射与槽位排版（.agents/skills/wanxiang-ui/SKILL.md §1）。 -->
    <PackageReference Include="IconPacks.Avalonia.Core" Version="2.0.0" />
    <PackageReference Include="IconPacks.Avalonia.Lucide" Version="2.0.0" />
    <PackageReference Include="Markdig" Version="1.3.2" />
    <PackageReference Include="QRCoder" Version="1.8.0" />
    <!-- 决策 332：客户端缩小超大图片。与 Avalonia 12.1.2 自带的 Skia 同版本，原生库由 App / Pwa 提供。 -->
    <PackageReference Include="SkiaSharp" Version="3.119.4" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Wanxiang2.AguiWire" Version="0.0.0-local" />
    <PackageReference Include="Wanxiang2.ChatDomain" Version="0.0.0-local" />
    <PackageReference Include="Wanxiang2.PlainText" Version="0.0.0-local" />
    <PackageReference Include="Wanxiang2.ToolSummary" Version="0.0.0-local" />
    <PackageReference Include="Wanxiang2.WsClient" Version="0.0.0-local" />
    <PackageReference Include="Wanxiang2.CommandPalette" Version="0.0.0-local" />
    <PackageReference Include="Wanxiang2.HljsHtml" Version="0.0.0-local" />
    <PackageReference Include="Wanxiang2.KatexHtml" Version="0.0.0-local" />
    <PackageReference Include="Wanxiang2.BoundedCache" Version="0.0.0-local" />
    <PackageReference Include="Wanxiang2.RichAssets" Version="0.0.0-local" />
    <PackageReference Include="Wanxiang2.BrowserCredentials" Version="0.0.0-local" />
    <PackageReference Include="Wanxiang2.BrowserDrafts" Version="0.0.0-local" />
    <PackageReference Include="Wanxiang2.BrowserPage" Version="0.0.0-local" />
    <PackageReference Include="Wanxiang2.BrowserProbe" Version="0.0.0-local" />
    <PackageReference Include="Wanxiang2.BrowserLocalStore" Version="0.0.0-local" />
    <PackageReference Include="Wanxiang2.PinyinInitials" Version="0.0.0-local" />
    <PackageReference Include="Wanxiang2.FuzzyMatch" Version="0.0.0-local" />
    <PackageReference Include="Wanxiang2.MessageLink" Version="0.0.0-local" />
    <PackageReference Include="Wanxiang2.ModelVision" Version="0.0.0-local" />
    <PackageReference Include="Wanxiang2.MediaTypes" Version="0.0.0-local" />
    <PackageReference Include="Wanxiang2.ReconnectBackoff" Version="0.0.0-local" />
    <PackageReference Include="Wanxiang2.ConnectionIssue" Version="0.0.0-local" />
  </ItemGroup>

</Project>
