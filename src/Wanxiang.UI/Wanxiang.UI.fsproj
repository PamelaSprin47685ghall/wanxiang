<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Wanxiang.UI</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="MainWindow.fs" />
    <Compile Include="App.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.0.0" />
    <PackageReference Include="Avalonia.Desktop" Version="12.0.0" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Wanxiang.Core\Wanxiang.Core.fsproj" />
    <ProjectReference Include="..\Wanxiang.Protocol\Wanxiang.Protocol.fsproj" />
    <ProjectReference Include="..\Wanxiang.Client\Wanxiang.Client.fsproj" />
  </ItemGroup>

</Project>
