<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Wanxiang.UI</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Model/StartupTrace.fs" />
    <Compile Include="Model/CommandPalette.fs" />
    <Compile Include="Model/DraftStore.fs" />
    <Compile Include="Model/UnansweredReply.fs" />
    <Compile Include="Controls/KeyShortcut.fs" />
  </ItemGroup>

  <!-- 内嵌字体（正文、等宽、KaTeX）归 Wanxiang2.ThemeFonts（avares://ThemeFonts）；这里只留品牌图。 -->
  <ItemGroup>
    <AvaloniaResource Include="Assets/logo.png" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.2" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.2" />
    <!-- 图标：Lucide 官方控件集（ISC）。字形几何全部由上游负责，
         万象只做语义映射与槽位排版（.agents/skills/wanxiang-ui/SKILL.md §1）。 -->
    <PackageReference Include="IconPacks.Avalonia.Core" Version="2.0.0" />
    <PackageReference Include="IconPacks.Avalonia.Lucide" Version="2.0.0" />
    <PackageReference Include="Markdig" Version="1.3.2" />
    <PackageReference Include="QRCoder" Version="1.8.0" />
    <!-- 决策 332：客户端缩小超大图片。与 Avalonia 12.1.2 自带的 Skia 同版本，原生库由 App / Pwa 提供。 -->
    <PackageReference Include="SkiaSharp" Version="3.119.4" />
  </ItemGroup>

