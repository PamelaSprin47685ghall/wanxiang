<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Auth.fs" />
  </ItemGroup>

  <ItemGroup>
    <!-- 配置模型、TOML 编解码、ConfigStore 来自 wanxiang2 交付包（tools/wanxiang2-feed.sh） -->
