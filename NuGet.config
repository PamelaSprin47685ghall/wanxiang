<?xml version="1.0" encoding="utf-8"?>
<!-- Wanxiang2.* 只从 vendor/wanxiang2 的本地交付源取（先跑 tools/wanxiang2-feed.sh）。
     包缓存放在仓库内 .nuget/packages，与机器全局缓存隔离，避免旧的 0.0.0-local。 -->
<configuration>
  <config>
    <add key="globalPackagesFolder" value=".nuget/packages" />
  </config>
  <packageSources>
    <clear />
    <add key="wanxiang2" value="vendor/wanxiang2/artifacts/feed" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="wanxiang2"><package pattern="Wanxiang2.*" /></packageSource>
    <packageSource key="nuget.org"><package pattern="*" /></packageSource>
  </packageSourceMapping>
</configuration>
