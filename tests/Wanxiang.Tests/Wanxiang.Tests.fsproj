<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Headless.fs" />
    <Compile Include="HeadlessTests.fs" />
    <Compile Include="Helpers.fs" />
    <Compile Include="EventLogTests.fs" />
    <Compile Include="AguiMappingTests.fs" />
    <Compile Include="MessageMapTests.fs" />
    <Compile Include="StoreConsistencyTests.fs" />
    <Compile Include="ReplayTests.fs" />
    <Compile Include="CoordinatorTests.fs" />
    <Compile Include="CatchUpSafetyTests.fs" />
    <Compile Include="ForkTests.fs" />
    <Compile Include="SessionAndForkTests.fs" />
    <Compile Include="ServerE2eTests.fs" />
    <Compile Include="ConfigTests.fs" />
    <Compile Include="AttachmentTests.fs" />
    <Compile Include="BugfixTests.fs" />
    <Compile Include="CodecTests.fs" />
    <Compile Include="ProductizationTests.fs" />
    <Compile Include="PolishTests.fs" />
    <Compile Include="MathRenderTests.fs" />
    <Compile Include="NativeTransportTests.fs" />
    <Compile Include="ScrollLayoutTests.fs" />
    <Compile Include="OperabilityTests.fs" />
    <Compile Include="ExchangeNavTests.fs" />
    <Compile Include="EndpointScrollTests.fs" />
    <Compile Include="CloseWindowTests.fs" />
    <Compile Include="MathBaselineTests.fs" />
    <Compile Include="RenderCostTests.fs" />
    <Compile Include="IncrementalRenderTests.fs" />
    <Compile Include="PathologicalRenderTests.fs" />
    <Compile Include="AsyncHighlightTests.fs" />
    <Compile Include="FocusRingTests.fs" />
    <Compile Include="SelectionOperabilityTests.fs" />
    <Compile Include="ReconnectBackoffTests.fs" />
    <Compile Include="DeliveryPolishingTests.fs" />
    <Compile Include="UiStabilityTests.fs" />
    <Compile Include="InteractionReliabilityTests.fs" />
    <Compile Include="ConversationExportTests.fs" />
    <Compile Include="CraftsmanshipPolishTests.fs" />
    <Compile Include="IconCenteringTests.fs" />
    <Compile Include="PresentationRefreshTests.fs" />
    <Compile Include="DesignConvergenceTests.fs" />
    <Compile Include="SearchHighlightTests.fs" />
    <Compile Include="SettingsSurfaceTests.fs" />
    <Compile Include="ConversationPresentationTests.fs" />
    <Compile Include="OverlayMenuTests.fs" />
    <Compile Include="KeyConvergenceTests.fs" />
    <Compile Include="InteractabilityConvergenceTests.fs" />
    <Compile Include="InteractabilityPolishTests.fs" />
    <Compile Include="InteractabilityPolish8Tests.fs" />
    <Compile Include="DismissFocusTests.fs" />
  </ItemGroup>

  <!-- 真 KaTeX 生成的 HTML 夹具：公式排版测试不必带一个 JS 引擎 -->
  <ItemGroup>
    <Content Include="fixtures/**" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- xunit v3 = MTP 原生（见根 global.json）。3.2.2 是稳定版。
         刻意**不**引入 Avalonia.Headless.XUnit：它在 .NET 10 上会死锁
         （上游 #21467 / #22021），改用底层 HeadlessUnitTestSession，见 Headless.fs。 -->
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <!-- 无显示环境下也能跑真实的 Skia 文本整形：公式排版的字体度量必须在测试里可验，
         否则每改一个数字都要重建 WASM 包再截图，一轮五分钟。 -->
    <PackageReference Include="Avalonia.Headless" Version="12.1.2" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.2" />
    <PackageReference Include="Avalonia.Skia" Version="12.1.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Wanxiang.Core\Wanxiang.Core.fsproj" />
    <ProjectReference Include="..\..\src\Wanxiang.Agui\Wanxiang.Agui.fsproj" />
    <ProjectReference Include="..\..\src\Wanxiang.Agent\Wanxiang.Agent.fsproj" />
    <ProjectReference Include="..\..\src\Wanxiang.Store\Wanxiang.Store.fsproj" />
    <ProjectReference Include="..\..\src\Wanxiang.Config\Wanxiang.Config.fsproj" />
    <ProjectReference Include="..\..\src\Wanxiang.Protocol\Wanxiang.Protocol.fsproj" />
    <ProjectReference Include="..\..\src\Wanxiang.Server\Wanxiang.Server.fsproj" />
    <ProjectReference Include="..\..\src\Wanxiang.Agent\Wanxiang.Agent.fsproj" />
    <ProjectReference Include="..\..\src\Wanxiang.UI\Wanxiang.UI.fsproj" />
  </ItemGroup>

</Project>
