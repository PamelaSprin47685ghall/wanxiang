<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="UiThreadGuard.fs" />
    <Compile Include="Headless.fs" />
    <Compile Include="UiThreadOwnershipTests.fs" />
    <Compile Include="HeadlessTests.fs" />
    <Compile Include="Helpers.fs" />
    <Compile Include="CardFixture.fs" />
    <Compile Include="LocalStateTests.fs" />
    <Compile Include="MessageMapTests.fs" />
    <Compile Include="ProjectionInvariantsTests.fs" />
    <Compile Include="CoordinatorTests.fs" />
    <Compile Include="ServerE2eTests.fs" />
    <Compile Include="SoakTests.fs" />
    <Compile Include="PerformanceBaselineTests.fs" />
    <Compile Include="OnboardingConfigTests.fs" />
    <Compile Include="PolishTests.fs" />
    <Compile Include="NativeTransportTests.fs" />
    <Compile Include="AgentCoverageTests.fs" />
    <Compile Include="ScrollLayoutTests.fs" />
    <Compile Include="OperabilityTests.fs" />
    <Compile Include="RenderCostTests.fs" />
    <Compile Include="PathologicalRenderTests.fs" />
    <Compile Include="IconCenteringTests.fs" />
    <Compile Include="DesignConvergenceTests.fs" />
    <Compile Include="StateConvergenceTests.fs" />
    <Compile Include="ConversationPresentationTests.fs" />
    <Compile Include="DialogsTests.fs" />
    <Compile Include="W3ToolApprovalUiTests.fs" />
    <Compile Include="ToolCallStatusTests.fs" />
    <Compile Include="UiPureLogicTests.fs" />
    <Compile Include="A11yRegressionTests.fs" />
    <Compile Include="ContinueLinkUndoTests.fs" />
    <Compile Include="R19SimplifyTests.fs" />
    <Compile Include="R21ImeTests.fs" />
    <Compile Include="PartialPersistAndUrlSchemeTests.fs" />
    <Compile Include="VisualPassR3Tests.fs" />
    <Compile Include="PwaMobileTests.fs" />
    <Compile Include="WsOriginTests.fs" />
    <Compile Include="ModelChipRateLimitTests.fs" />
    <Compile Include="AttachmentVisionTests.fs" />
    <Compile Include="R17CapabilityTests.fs" />
  </ItemGroup>

  <!-- 真 KaTeX 生成的 HTML 夹具：公式排版测试不必带一个 JS 引擎 -->
  <ItemGroup>
    <Content Include="fixtures/**" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- xunit v3 = MTP 原生（见根 global.json）。3.2.2 是稳定版。
         刻意**不**引入 Avalonia.Headless.XUnit：它在 .NET 10 上会死锁
         （上游 #21467 / #22021），改用底层 HeadlessUnitTestSession，见 Headless.fs。 -->
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <!-- 无显示环境下也能跑真实的 Skia 文本整形：公式排版的字体度量必须在测试里可验，
         否则每改一个数字都要重建 WASM 包再截图，一轮五分钟。 -->
    <PackageReference Include="Avalonia.Headless" Version="12.1.2" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.2" />
    <PackageReference Include="Avalonia.Skia" Version="12.1.2" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Wanxiang2.ServerApp" Version="0.0.0-local" />
    <PackageReference Include="Wanxiang2.AgentRuntime" Version="0.0.0-local" />
    <PackageReference Include="Wanxiang2.ProviderFailure" Version="0.0.0-local" />
    <PackageReference Include="Wanxiang2.AgentContent" Version="0.0.0-local" />
    <PackageReference Include="Wanxiang2.AgentHistory" Version="0.0.0-local" />
    <PackageReference Include="Wanxiang2.AguiMessageMap" Version="0.0.0-local" />
    <PackageReference Include="Wanxiang2.MessageSerde" Version="0.0.0-local" />
    <PackageReference Include="Wanxiang2.MediaContent" Version="0.0.0-local" />
    <PackageReference Include="Wanxiang2.ProviderTransports" Version="0.0.0-local" />
    <PackageReference Include="Wanxiang2.EventStore" Version="0.0.0-local" />
    <PackageReference Include="Wanxiang2.AguiWire" Version="0.0.0-local" />
    <PackageReference Include="Wanxiang2.ChatDomain" Version="0.0.0-local" />
    <PackageReference Include="Wanxiang2.PlainText" Version="0.0.0-local" />
    <PackageReference Include="Wanxiang2.ToolSummary" Version="0.0.0-local" />
    <ProjectReference Include="..\..\src\Wanxiang.UI\Wanxiang.UI.fsproj" />
    <PackageReference Include="Wanxiang2.MessageCardView" Version="0.0.0-local" />
    <PackageReference Include="Wanxiang2.WsClient" Version="0.0.0-local" />
    <PackageReference Include="Wanxiang2.ReconnectBackoff" Version="0.0.0-local" />
    <PackageReference Include="Wanxiang2.ConnectionIssue" Version="0.0.0-local" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Wanxiang2.ConfigStore" Version="0.0.0-local" />
    <PackageReference Include="Wanxiang2.PairingDesk" Version="0.0.0-local" />
  </ItemGroup>

  <!-- 阶段 3：测试基建改造。宿主旧符号（Tokens/MotionPolicy/ControlMetrics/Ui 等）已迁入 wanxiang2，
       测试工程显式引用对应包（与 src/Wanxiang.UI 的消费面一致，Version 格式沿用 0.0.0-local）。 -->
  <ItemGroup>
    <PackageReference Include="Wanxiang2.Theme" Version="0.0.0-local" />
    <PackageReference Include="Wanxiang2.ThemePalette" Version="0.0.0-local" />
    <PackageReference Include="Wanxiang2.ThemeMetrics" Version="0.0.0-local" />
    <PackageReference Include="Wanxiang2.MotionSwitch" Version="0.0.0-local" />
    <PackageReference Include="Wanxiang2.SpacingRamp" Version="0.0.0-local" />
    <PackageReference Include="Wanxiang2.DesignRhythm" Version="0.0.0-local" />
    <PackageReference Include="Wanxiang2.EntryShells" Version="0.0.0-local" />
    <PackageReference Include="Wanxiang2.ImageShrinkIo" Version="0.0.0-local" />
    <PackageReference Include="Wanxiang2.ReadingLook" Version="0.0.0-local" />
    <PackageReference Include="Wanxiang2.MarkdownView" Version="0.0.0-local" />
    <PackageReference Include="Wanxiang2.CodeTint" Version="0.0.0-local" />
    <PackageReference Include="Wanxiang2.RichBackend" Version="0.0.0-local" />
    <PackageReference Include="Wanxiang2.UiPrimitives" Version="0.0.0-local" />
    <PackageReference Include="Wanxiang2.FieldCheck" Version="0.0.0-local" />
    <PackageReference Include="Wanxiang2.PopupMenu" Version="0.0.0-local" />
    <PackageReference Include="Wanxiang2.OverlayDesk" Version="0.0.0-local" />
    <PackageReference Include="Wanxiang2.DialogsDesk" Version="0.0.0-local" />
    <PackageReference Include="Wanxiang2.AppShell" Version="0.0.0-local" />
    <PackageReference Include="Wanxiang2.UiPrefsFile" Version="0.0.0-local" />
  </ItemGroup>
</Project>
